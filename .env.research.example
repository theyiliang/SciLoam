# 科研入口：app.presentation.server:app。不要直接覆盖既有.env。
RESEARCH_DATA_DIR=./research-data
RESEARCH_ENV=development
RESEARCH_COOKIE_SECURE=0
RESEARCH_ALLOWED_HOSTS=localhost,127.0.0.1

# 可选；不填时仅本地证据摘录，不会生成AI对齐结论。
# 配置前确认科研资料允许发送到所选服务。
# LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max
# 工程闸门：有限重试、备用模型、超时、工具迭代和输入预算
LLM_MAX_CONCURRENCY=2
LLM_MIN_INTERVAL_SECONDS=1
LLM_MAX_RETRIES=2
LLM_FALLBACK_MODEL=qwen-plus
RESEARCH_MODEL_TIMEOUT_SECONDS=45
RESEARCH_TOOL_TIMEOUT_SECONDS=15
RESEARCH_PIPELINE_TIMEOUT_SECONDS=180
# 允许1-10轮工具往返；预算用完后最多再进行1轮禁用工具的最终回答，提前回答不增加调用。
RESEARCH_MAX_TOOL_ITERATIONS=3
RESEARCH_TOTAL_INPUT_CHARS=240000

# 科研RAG：默认本地BM25分块检索，不调用外部Embedding或重排。
RESEARCH_RETRIEVAL_MODE=local
# 需要hybrid时同时设置模式和明确许可；会发送授权资料片段至所配置服务。
RESEARCH_RAG_ALLOW_EXTERNAL=0
# RESEARCH_RETRIEVAL_MODE=hybrid
# RESEARCH_RAG_ALLOW_EXTERNAL=1
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=填写服务凭据
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_MAX_BATCH=10
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_URL为空则使用RESEARCH_DATA_DIR/qdrant-research本地存储
# 可选重排，不配置则按双路RRF排序。URL和MODEL必须同时配置。
# RERANKER_BASE_URL=https://your-reranker-service.example
# RERANKER_API_KEY=填写服务凭据
# RERANKER_MODEL=填写实际已部署模型

# 生产必须HTTPS，并设置：
# RESEARCH_ENV=production
# RESEARCH_COOKIE_SECURE=1
# RESEARCH_ALLOWED_HOSTS=research.example.org,localhost,127.0.0.1
